{
  "manifestVersion": 5,
  "id": "com.magnusholmes.filmdust",
  "name": "film dust",
  "version": "1.8.52",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "filmdust",
      "label": {
        "default": "film dust"
      },
      "minimumSize": {
        "width": 260,
        "height": 300
      },
      "maximumSize": {
        "width": 900,
        "height": 1600
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 420
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 460
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/dark.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium"
          ],
          "species": [
            "chrome"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/light.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ],
          "species": [
            "chrome"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ]
}
